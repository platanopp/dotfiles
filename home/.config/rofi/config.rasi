configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "breeze-dark";
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "󰍉";
    display-run: "󰍉";
}

* {
    bg: #111114;
    bg-alt: rgba(255, 255, 255, 0.04);
    fg: #d8d8d8;
    fg-alt: #6b6b6b;
    fg-bright: #ffffff;
    selected-bg: rgba(255, 255, 255, 0.12);
    selected-fg: #ffffff;
    urgent-fg: #c99387;
    urgent-selected-bg: rgba(201, 147, 135, 0.20);
    border-color: rgba(255, 255, 255, 0.20);

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    background-color: rgba(17, 17, 20, 0.90);
    border: 1px;
    border-color: @border-color;
    border-radius: 16px;
    padding: 12px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 12px;
    padding: 4px;
}

inputbar {
    background-color: @bg-alt;
    text-color: @fg;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 19";
}

entry {
    background-color: transparent;
    placeholder: "Buscar...";
    placeholder-color: @fg-alt;
    text-color: @fg-bright;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    padding: 4px 0px;
    scrollbar: true;
    fixed-height: false;
}

scrollbar {
    background-color: transparent;
    width: 4px;
    handle-color: rgba(255, 255, 255, 0.15);
    handle-width: 4px;
    border-radius: 4px;
}

element {
    background-color: transparent;
    padding: 8px 10px;
    border-radius: 10px;
    spacing: 10px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @urgent-fg;
}

element selected.urgent {
    background-color: @urgent-selected-bg;
    text-color: @fg-bright;
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @fg;
}

element selected.active {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    background-color: transparent;
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

message {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 8px;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}
